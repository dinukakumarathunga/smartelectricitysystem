# ============================================================
#  .env.example
#  Copy this file to .env and fill in real values.
#  .env is git-ignored — never commit real secrets.
# ============================================================

# ── Core Flask ────────────────────────────────────────────────
FLASK_ENV=development
FLASK_APP=app.py
SECRET_KEY=replace-with-a-long-random-string

# ── Database ─────────────────────────────────────────────────
# mysql+pymysql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=mysql+pymysql://root:root@localhost:3306/smartelec_dev
TEST_DATABASE_URL=sqlite:///test.db

# ── Session cookies ──────────────────────────────────────────
# Set to True only when serving over HTTPS (required in production).
SESSION_COOKIE_SECURE=False

# ── OTP ──────────────────────────────────────────────────────
# 'email' or 'sms' — pick one; only that channel's block below is needed.
OTP_CHANNEL=email

# ── Email (only needed if OTP_CHANNEL=email) ─────────────────
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-app-email@gmail.com
MAIL_PASSWORD=your-app-password-or-app-specific-password
MAIL_DEFAULT_SENDER=your-app-email@gmail.com

# ── SMS via Twilio (only needed if OTP_CHANNEL=sms) ──────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── File uploads ─────────────────────────────────────────────
# Absolute or relative to project root. The route layer creates
# this folder at runtime if it doesn't exist (see uploads/ note
# in the file structure — Flask auto-creates it).
UPLOAD_FOLDER=uploads/temp

# ── OCR ──────────────────────────────────────────────────────
# Only needed on Windows or if tesseract isn't on PATH, e.g.:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# ── ML prediction models ──────────────────────────────────────
ML_MODELS_DIR=ml_models
